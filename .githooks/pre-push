#!/bin/sh
# Refuse pushes that update a protected branch on any remote. Changes reach main via PR only.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push to '${remote_ref#refs/heads/}'. Open a PR instead." >&2
      status=1
      ;;
  esac
done
exit $status
